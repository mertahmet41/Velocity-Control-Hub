; Script generated by Inno Setup Script Wizard.
#define MyAppName "Velocity Control Hub"
#define MyAppVersion "3.0.0"
#define MyAppPublisher "Mert Ahmet (Sim Racing Systems)"
#define MyAppExeName "VelocityControlHub.exe"

[Setup]
AppId={{E893441A-74A1-4F2A-A81E-47C7B190226B}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
DefaultDirName={autopf}\{#MyAppName}
UninstallDisplayIcon={app}\{#MyAppExeName}
DisableProgramGroupPage=yes
OutputDir=C:\Users\amome\Desktop
OutputBaseFilename=Velocity_Control_Hub_Setup
Compression=lzma
SolidCompression=yes
WizardStyle=modern

[Languages]
Name: "turkish"; MessagesFile: "compiler:Languages\Turkish.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "C:\Users\amome\Desktop\VelocityControlHub\dist\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Users\amome\Desktop\VelocityControlHub\index.html"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Users\amome\Desktop\VelocityControlHub\pro_wheel.png"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Users\amome\Desktop\VelocityControlHub\OpenFFBoard_F411CE_V3_Profiles.hex"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent
